<Window x:Class="ScreenTimeClient.Views.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime Primary Lock Screen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0F172A">
    <Grid>
        <!-- Background subtle glow -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="520" Height="520"
                CornerRadius="260"
                Opacity="0.15">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#4F46E5" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Center Card -->
        <Border Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="20"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- Clock -->
                <TextBlock x:Name="ClockText" 
                           Text="12:00 PM" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           Foreground="#F8FAFC" 
                           HorizontalAlignment="Center"/>
                
                <TextBlock x:Name="DateText" 
                           Text="Tuesday, November 10" 
                           FontSize="14" 
                           Foreground="#94A3B8" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,24"/>

                <!-- Lock Status Badge -->
                <Border Background="#292524" 
                        BorderBrush="#78350F" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,6" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 " FontSize="14"/>
                        <TextBlock Text="SCREEN TIME LOCKED" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#FBBF24"/>
                    </StackPanel>
                </Border>

                <!-- Child Name & Instructions -->
                <TextBlock x:Name="ChildGreetingText" 
                           Text="Hi, Lucas!" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#F8FAFC" 
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="StatusSubtext" 
                           Text="Your screen time is currently paused. Ask your parents for time or use emergency dialer." 
                           FontSize="13" 
                           Foreground="#94A3B8" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           Margin="0,8,0,28"/>

                <!-- Action Buttons -->
                <Button x:Name="RequestButton" 
                        Click="OnRequestClicked"
                        Background="#4F46E5" 
                        Foreground="White" 
                        FontSize="15" 
                        FontWeight="SemiBold" 
                        Height="48" 
                        Cursor="Hand"
                        Margin="0,0,0,12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✋ " FontSize="16"/>
                        <TextBlock x:Name="RequestButtonText" Text="Request Screen Time"/>
                    </StackPanel>
                </Button>

                <Button Click="OnEmergencyClicked"
                        Background="#334155" 
                        Foreground="#E2E8F0" 
                        FontSize="13" 
                        FontWeight="Medium" 
                        Height="40" 
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📞 " FontSize="14"/>
                        <TextBlock Text="Emergency Contact"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
