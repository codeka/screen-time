<Window x:Class="ScreenTimeClient.Views.BackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime Secondary Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0F172A">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
            <TextBlock Text="⏱️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Screen Time Locked" FontSize="20" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Please see primary display" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>

